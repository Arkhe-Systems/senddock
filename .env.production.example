# Production .env for source builds (docker-compose.prod.yml).
# For the prebuilt-image install, see docs/self-hosting/installation.md (Option 1).
#
# Usage:
#   cp .env.production.example .env
#   # replace every "change-me-..." below
#   docker compose -f docker-compose.prod.yml up -d --build

# === REQUIRED ===

# JWT signing secret (min 32 chars) — generate with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# Postgres password — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-openssl-rand-base64-32

# Public URL where this instance is reachable from the internet.
# Used for CORS, unsubscribe links and tracking pixels inside outgoing emails.
# For a local test, http://localhost:8080 is fine.
# For production, use your real domain: https://email.example.com
FRONTEND_URL=http://localhost:8080

# === OPTIONAL ===

# Override the public URL used in outgoing-email links.
# Leave blank to fall back to FRONTEND_URL (correct for single-binary deploys).
# PUBLIC_URL=

# Deployment mode — keep as 'self-hosted'. 'cloud' is reserved for the
# managed senddock.dev product and requires the cloud package.
DEPLOYMENT_MODE=self-hosted

# Per-IP request cap, rolling 60s window. Default 600. Only enforced with Redis.
# RATE_LIMIT_PER_MINUTE=600
