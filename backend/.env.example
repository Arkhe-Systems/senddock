DATABASE_URL=postgres://senddock:senddock_dev@localhost:5434/senddock?sslmode=disable
JWT_SECRET=change-this-to-a-random-secret
PORT=8080
REDIS_URL=redis://localhost:6380
DEPLOYMENT_MODE=self-hosted

# Origin the SPA is served from during development, used for CORS.
# Once a public URL is set in the dashboard, that value takes over.
FRONTEND_URL=http://localhost:5173

# The public URL and the Pro license key are no longer configured here.
# Set them under Instance in the dashboard; they apply without a restart.
# Values still present in the environment are imported on first boot and
# support for them is removed in v0.9.

# Per-IP request cap for the global rate limiter, counted in a rolling 60s window.
# Only enforced when REDIS_URL is set. Default 600.
# RATE_LIMIT_PER_MINUTE=600

# Optional Watchtower integration for one-click updates from the dashboard.
# When both URL and TOKEN are set and the Watchtower HTTP API is reachable,
# the update modal shows an "Update now" button that triggers a Watchtower run.
# See docs/self-hosting/updating.md for the full compose snippet.
# SENDDOCK_WATCHTOWER_URL=http://watchtower:8080
# SENDDOCK_WATCHTOWER_TOKEN=

# Manifest URL for the starter template library. Defaults to the public
# Arkhe-Systems/senddock-templates repo. Override to point at your own
# manifest (e.g. an internal fork or a private gallery).
# TEMPLATE_LIBRARY_URL=https://raw.githubusercontent.com/Arkhe-Systems/senddock-templates/main/index.json
